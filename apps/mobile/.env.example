# Public config only (shipped in the bundle). No secrets here (M5, ME3).
# mock = in-memory fixtures (default) · live = Lenapay API at EXPO_PUBLIC_API_URL
EXPO_PUBLIC_API_MODE=mock
# Leave empty in development to derive http://<metro-host>:18080 from Metro's host (the
# compose stack's API port). On a phone use the PC's LAN IP, e.g. http://192.168.68.53:18080.
# Development builds can also switch both values at runtime: Settings → Desarrollador.
EXPO_PUBLIC_API_URL=
