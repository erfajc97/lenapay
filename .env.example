# Lenapay local environment. `make up` copies this file to .env (git-ignored) on the first run.
# Every value here is a development placeholder; production sets real secrets and the API
# refuses development defaults there (internal/platform/config).

# --- compose: host ports and the local database
POSTGRES_USER=lenapay
POSTGRES_PASSWORD=lenapay
POSTGRES_DB=lenapay
POSTGRES_PORT=5433
API_PORT=8080
BINDMOCK_PORT=8090

# --- API (internal/platform/config)
APP_ENV=development
# Used when running the API on the host (`make api`); compose overrides it with the service host.
DATABASE_URL=postgres://lenapay:lenapay@localhost:5433/lenapay?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=INFO
DB_MAX_CONNS=10
MIGRATE_ON_START=true
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=20s
BODY_LIMIT_BYTES=1048576
UPLOAD_LIMIT_BYTES=10485760
RATE_LIMIT_PER_MINUTE=300
# Expo web dev servers; native apps do not use CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUSTED_PROXY_CIDRS=
BUSINESS_TIME_ZONE=America/Argentina/Buenos_Aires

# Local identity provider. Base64 32-byte Ed25519 seed; empty in development = ephemeral key.
# Generate one with: openssl rand -base64 32
JWT_ISSUER=http://localhost:8080
JWT_PRIVATE_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
STEP_UP_TOKEN_TTL=5m

# Ops endpoints (/internal/*) header X-Internal-Api-Key. At least 16 characters.
INTERNAL_API_KEY=<dev-internal-api-key-change-me>

# PSP (apps/bind-mock locally). The webhook secret must be the same for api and bind-mock.
PSP_BASE_URL=http://localhost:8090
PSP_WEBHOOK_SECRET=<dev-psp-webhook-secret-change-me>
PSP_TIMEOUT=10s
PSP_WEBHOOK_TOLERANCE=5m

# Features and fakes
PERSONAL_MODE_ENABLED=false
ERP_FIXTURES_DIR=fixtures/erp
KYC_FAKE_REJECTED_DNIS=11111111
DEV_INBOX_ENABLED=true

# --- bind-mock (apps/bind-mock/internal/config)
BINDMOCK_HTTP_ADDR=:8090
BINDMOCK_WEBHOOK_URL=http://localhost:8080/webhooks/psp/transfers
